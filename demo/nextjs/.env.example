# Required when the SCIM demo is enabled; use HTTPS outside localhost or loopback.
BETTER_AUTH_URL=http://170.106.176.163
# Generate once with npx auth@latest secret and keep it stable for this database.
BETTER_AUTH_SECRET=
# Enables the local SCIM workflow. Keep this disabled outside trusted demo environments.
SCIM_DEMO_ENABLED=false
# cspell:ignore HMAC
# Server-only HMAC pepper used to digest generated SCIM credentials at rest.
# Use at least 32 random characters and never expose it through a NEXT_PUBLIC_ variable.
SCIM_DEMO_CREDENTIAL_PEPPER=
# Server-only OIDC client secret required to enable the employee sign-in demo.
# Use at least 32 random characters and keep it out of NEXT_PUBLIC_ variables;
# SCIM provisioning works without it.
SCIM_DEMO_OIDC_CLIENT_SECRET=
# Server-only RSA private JWK or PKCS#8 PEM used to sign demo OIDC tokens.
# Required outside loopback. Localhost and loopback development generate an
# ephemeral signing key when this is empty.
SCIM_DEMO_OIDC_SIGNING_PRIVATE_KEY=
# Optional local SQLite database path used by the demo and its end-to-end tests.
DEMO_SQLITE_PATH=./demo.sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RESEND_API_KEY=
TEST_EMAIL=
NODE_ENV=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
